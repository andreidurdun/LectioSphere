{
  "name": "lectiosphere-e2e",
  "private": true,
  "scripts": {
    "clean": "if exist allure-results rmdir /s /q allure-results",
    "test": "wdio run wdio.conf.js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test-and-report": "npm run test && npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.23.2",
    "@wdio/appium-service": "^9.23.2",
    "@wdio/cli": "^9.23.2",
    "@wdio/local-runner": "^9.23.2",
    "@wdio/mocha-framework": "^9.23.2",
    "@wdio/spec-reporter": "^9.23.2",
    "appium": "^3.2.0",
    "webdriverio": "^9.23.2"
  }
}
