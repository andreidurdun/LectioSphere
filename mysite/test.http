### US01 - Resend activation email
POST {{baseUrl}}/auth/users/resend_activation/ HTTP/1.1
Content-Type: application/json

{
    "email": "{{testEmail}}"
}

###

### US01 - Activate account
# Copy uid and token from the activation email before sending this request.
POST {{baseUrl}}/auth/users/activation/ HTTP/1.1
Content-Type: application/json

{
    "uid": "{{activationUid}}",
    "token": "{{activationToken}}"
}

###

### US02 - Request password reset
POST {{baseUrl}}/auth/users/reset_password/ HTTP/1.1
Content-Type: application/json

{
    "email": "{{testEmail}}"
}

###

### US02 - Confirm password reset
# Copy uid and token from the password reset email. This sets the new password to @testPassword.
POST {{baseUrl}}/auth/users/reset_password_confirm/ HTTP/1.1
Content-Type: application/json

{
    "uid": "{{resetUid}}",
    "token": "{{resetToken}}",
    "new_password": "{{testPassword}}"
}

###

### US02 - Login valid
# @name loginValid
POST {{baseUrl}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
}

###

### US02 - Login with wrong password
POST {{baseUrl}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
    "email": "{{testEmail}}",
    "password": "WrongVioletOrbit!7429"
}

###

### US02 - Login with nonexistent user
POST {{baseUrl}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
    "email": "no.such.user@example.com",
    "password": "{{testPassword}}"
}

###

### US03 - Logout
POST {{baseUrl}}/api/accounts/logout/ HTTP/1.1
Content-Type: application/json

{
    "refresh": "{{loginValid.response.body.$.refresh}}"
}

